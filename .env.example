# Copy to .env and fill in. .env is gitignored.
#
# NO model key is needed for the default setup: all four agents authenticate off the
# local `claude login` subscription via ClaudeSDKAdapter.

# --- Cross-family critic (recommended) -------------------------------------
# Put the GATEKEEPER on a different model family. It only reads evidence and rules,
# so it needs no shell -- which is exactly why Gemini fits there and not on the
# Verifier. Two wins: the critic is not the author's own judgment (a judging
# criterion), and one subscription stops carrying four concurrent agents.
#
#   ADAPTER_GATEKEEPER=gemini
#
# Free key from https://aistudio.google.com
GEMINI_API_KEY=

# --- Optional, if you ever put a role on Codex -----------------------------
# OPENAI_API_KEY=

# --- Per-role overrides ----------------------------------------------------
# ADAPTER_<ROLE> = claude | codex | gemini   (builder/verifier must be claude|codex)
# MODEL_<ROLE>   = a model id; omit to use the adapter's own default
# EFFORT_<ROLE>  = codex reasoning effort
#
# ADAPTER_GATEKEEPER=gemini
# MODEL_GATEKEEPER=gemini-3.8-flash

# --- Non-default Band server (rarely needed) -------------------------------
# BAND_REST_URL=https://app.band.ai
# BAND_WS_URL=wss://app.band.ai/api/v1/socket/websocket
